  .quote-card.bump { animation: bump 0.35s cubic-bezier(0.2, 0.7, 0.2, 1); }
  @keyframes bump { 40% { box-shadow: 0 0 0 4px rgba(236, 254, 106, 0.18); } 100% { box-shadow: 0 0 0 0 rgba(236, 254, 106, 0); } }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
