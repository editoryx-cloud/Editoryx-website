<script>
(function () {
  /* ------------------------------------------------------------------
     SETTINGS
     Where the form goes. Leave FORM_ENDPOINT empty and the form opens
     the visitor's email app with everything filled in, addressed to
     CONTACT_EMAIL. If you use a form service (Formspree, Basin, etc.),
     paste its URL between the quotes and submissions go there instead.
  ------------------------------------------------------------------ */
  var FORM_ENDPOINT = "";
  var CONTACT_EMAIL = "hello@editoryx.co";

  /* PRICES: what one video costs, in dollars. Change a number here and
     every quote on the page follows. */
  /* STRIPE LINKS: one checkout link per price. Each is a monthly
     per-video price with adjustable quantity, so the customer sets
     how many videos they want on the Stripe page. */
  var LINKS = {
    reels: {
      basic:    "https://buy.stripe.com/14A6oAa2GdOpaov3Yv2Nq0F",
      advanced: "https://buy.stripe.com/cNi5kw4Im5hT7cjfHd2Nq0z",
      premium:  "https://buy.stripe.com/3cIdR24Im25HfIP1Qn2Nq0A"
    },
    long: {
      basic:    "https://buy.stripe.com/7sYbIUcaObGh0NV0Mj2Nq0B",
      advanced: "https://buy.stripe.com/6oUfZacaO8u5fIP66D2Nq0C",
      premium:  "https://buy.stripe.com/3cI8wI1wa25HgMT3Yv2Nq0D"
    }
  };
  var RATES = {
    reels: { basic: 25, advanced: 40, premium: 60 },
    long:  { basic: 80, advanced: 120, premium: 160 }
  };
  var TIERS = {
    reels: {
      basic: ["Music", "Captions"],
      advanced: ["Animations", "Effects"],
      premium: ["AI effects", "Color grade"]
    },
    long: {
      basic: ["Clean cuts", "Music"],
      advanced: ["Animations", "Graphics"],
      premium: ["AI effects", "Full production"]
    }
  };
  var TIER_NAMES = { basic: "Basic", advanced: "Advanced", premium: "Premium" };
  var MIN = 1, MAX = 200;
  var REDUCE_MOTION = !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
  var shownQuote = null, quoteFrame = 0;

  function el(id) { return document.getElementById(id); }
  var countInput = el("count");
  var form = el("requestForm");
  var status = el("formStatus");
  var sendBtn = el("sendBtn");

  function checked(name) {
    return document.querySelector('input[name="' + name + '"]:checked').value;
  }
  function getCount() {
    var n = parseInt(countInput.value, 10);
    if (isNaN(n)) n = MIN;
    return Math.min(MAX, Math.max(MIN, n));
  }
  function money(n) { return "$" + n.toLocaleString("en-US"); }
  function lower(s) { return s === "AI effects" ? s : s.charAt(0).toLowerCase() + s.slice(1); }

  // The quote counts up or down to its new value instead of snapping
  function rollQuote(target) {
    var node = el("quotePrice");
    var finalText = money(target);
    cancelAnimationFrame(quoteFrame);
    if (shownQuote === null || shownQuote === target || REDUCE_MOTION || !window.requestAnimationFrame) {
      shownQuote = target;
      node.textContent = finalText;
      node.style.setProperty("--chars", finalText.length);
      return;
    }
    var from = shownQuote, start = null, dur = 420;
    node.style.setProperty("--chars", Math.max(finalText.length, money(from).length));
    var card = node.parentNode;
    card.classList.remove("bump"); void card.offsetWidth; card.classList.add("bump");
    function tick(now) {
      if (start === null) start = now;
      var t = Math.min(1, (now - start) / dur);
      var eased = 1 - Math.pow(1 - t, 3);
      shownQuote = Math.round(from + (target - from) * eased);
      node.textContent = money(shownQuote);
      if (t < 1) { quoteFrame = requestAnimationFrame(tick); }
      else { shownQuote = target; node.textContent = finalText; node.style.setProperty("--chars", finalText.length); }
    }
    quoteFrame = requestAnimationFrame(tick);
  }

  function render() {
    var type = checked("type");
    var quality = checked("quality");
    var n = getCount();
    var features = TIERS[type][quality];
    var rate = RATES[type][quality];
    var unit = type === "reels" ? "reel" : "video";
    var units = type === "reels" ? "reels" : "videos";
    var longName = type === "reels" ? (n === 1 ? "reel" : "reels") : (n === 1 ? "long-form video" : "long-form videos");

    // Highlight the selected cards
    document.querySelectorAll(".choice").forEach(function (c) {
      c.classList.toggle("is-on", c.querySelector("input").checked);
    });

    // Quality cards follow the content type
    ["basic", "advanced", "premium"].forEach(function (q) {
      var f = TIERS[type][q];
      document.querySelector('[data-note="' + q + '"]').textContent = f[0] + " + " + lower(f[1]);
      document.querySelector('[data-rate="' + q + '"]').textContent = money(RATES[type][q]) + "/" + unit;
    });
    el("unit").textContent = units + "/mo";

    // Quote: videos x price per video
    var total = money(n * rate);
    rollQuote(n * rate);
    el("quoteCount").textContent = n + " " + (n === 1 ? unit : units) + "/mo";
    el("quoteRate").textContent = money(rate) + "/" + unit;
    el("featA").textContent = features[0];
    el("featB").textContent = features[1];

    // Subscribe button goes to the checkout for this type + quality
    el("subscribeBtn").href = LINKS[type][quality];
    var note = el("quoteNote");
    note.textContent = "";
    note.appendChild(document.createTextNode("At checkout, set the quantity to "));
    var strong = document.createElement("strong");
    strong.textContent = n;
    note.appendChild(strong);
    note.appendChild(document.createTextNode(" to match this quote."));

    var summary = n + " " + longName + " a month, " + TIER_NAMES[quality] + " quality";
    el("recapText").textContent = summary;
    el("recapQuote").textContent = total + "/mo";
    el("planField").value = summary + " (" + features[0] + " + " + features[1] + ")";
    el("quoteField").value = total + " a month (" + money(rate) + " per " + unit + ")";
    el("liveSummary").textContent = summary + ". Quote: " + total + " a month.";
  }

  document.querySelectorAll('input[name="type"], input[name="quality"]').forEach(function (r) {
    r.addEventListener("change", render);
  });
  countInput.addEventListener("input", render);
  countInput.addEventListener("blur", function () { countInput.value = getCount(); render(); });
  el("minus").addEventListener("click", function () {
    countInput.value = Math.max(MIN, getCount() - 1); render();
  });
  el("plus").addEventListener("click", function () {
    countInput.value = Math.min(MAX, getCount() + 1); render();
  });

  function val(id) { return el(id).value.trim(); }

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    countInput.value = getCount();
    render();
    status.className = "form-status";

    var data = {
      "Plan": el("planField").value,
      "Quote": el("quoteField").value,
      "First name": val("firstName"),
      "Last name": val("lastName"),
      "Email": val("email"),
      "Platforms": val("platforms"),
      "Content style": val("contentStyle"),
      "References": val("references")
    };

    if (FORM_ENDPOINT) {
      sendBtn.disabled = true;
      status.textContent = "Submitting your onboarding…";
      fetch(FORM_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept": "application/json" },
        body: JSON.stringify(data)
      }).then(function (res) {
        if (!res.ok) throw new Error("Request failed");
        form.reset();
        render();
        status.textContent = "Onboarding submitted. We'll email " + data["Email"] + " to confirm and get started.";
      }).catch(function () {
        status.className = "form-status error";
        status.innerHTML = 'Your onboarding didn\'t send. Try again, or email it to <a href="mailto:' + CONTACT_EMAIL + '">' + CONTACT_EMAIL + "</a>.";
      }).then(function () { sendBtn.disabled = false; });
      return;
    }

    var lines = Object.keys(data).map(function (k) { return k + ": " + (data[k] || "-"); });
    var subject = "New client onboarding: " + el("recapText").textContent + ", " + el("recapQuote").textContent;
    window.location.href = "mailto:" + CONTACT_EMAIL +
      "?subject=" + encodeURIComponent(subject) +
      "&body=" + encodeURIComponent(lines.join("\n"));
    status.textContent = "Your email app should open with your onboarding filled in. Press send to finish.";
  });

  render();
})();

/* ---------- Motion: scroll reveals, counting stats, drifting hero text ---------- */
(function () {
  var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reduce || !("IntersectionObserver" in window)) return;
  try {

  // Mark elements to reveal; siblings marked in one call come in one after another
  function mark(selector, stagger) {
    var counts = [];
    document.querySelectorAll(selector).forEach(function (node) {
      var entry = null;
      for (var i = 0; i < counts.length; i++) { if (counts[i].parent === node.parentNode) entry = counts[i]; }
      if (!entry) { entry = { parent: node.parentNode, n: 0 }; counts.push(entry); }
      node.setAttribute("data-reveal", "");
      node.style.setProperty("--d", (entry.n * (stagger || 0)) + "ms");
      entry.n += 1;
    });
  }
  mark(".section .eyebrow, .section h2, .section .lede", 90);
  mark(".step", 110);
  mark(".trial");
  mark(".group", 100);
  mark(".quote-card");
  mark(".contact-points li", 90);
  mark(".onboard");

  function countUp(node) {
    var target = parseInt(node.getAttribute("data-count"), 10);
    var prefix = node.getAttribute("data-prefix") || "";
    var suffix = node.getAttribute("data-suffix") || "";
    var start = null, dur = 1300;
    function tick(now) {
      if (start === null) start = now;
      var t = Math.min(1, (now - start) / dur);
      var eased = 1 - Math.pow(1 - t, 3);
      node.textContent = prefix + Math.round(target * eased) + suffix;
      if (t < 1) requestAnimationFrame(tick);
    }
    node.textContent = prefix + "0" + suffix;
    requestAnimationFrame(tick);
  }

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;
      var node = entry.target;
      io.unobserve(node);
      if (node.hasAttribute("data-count")) { setTimeout(function () { countUp(node); }, 900); return; }
      node.classList.add("in");
      // Once it has arrived, hand the element back to its normal styles
      var wait = 1700 + (parseInt(node.style.getPropertyValue("--d"), 10) || 0);
      setTimeout(function () { node.removeAttribute("data-reveal"); node.classList.remove("in"); node.style.removeProperty("--d"); }, wait);
    });
  }, { threshold: 0.08, rootMargin: "0px 0px -6% 0px" });
  document.querySelectorAll("[data-reveal], [data-count]").forEach(function (node) { io.observe(node); });
  document.documentElement.classList.add("motion");
  } catch (err) {
    document.documentElement.classList.remove("motion");
    return;
  }

  // The outlined EDIT behind the hero drifts as you scroll
  var ghost = document.querySelector(".hero-ghost");
  var ticking = false;
  window.addEventListener("scroll", function () {
    if (ticking || !ghost) return;
    ticking = true;
    requestAnimationFrame(function () {
      var y = window.scrollY || 0;
      if (y < window.innerHeight * 1.5) ghost.style.transform = "translate3d(" + (y * -0.06) + "px," + (y * 0.18) + "px,0)";
      ticking = false;
    });
  }, { passive: true });
})();
</script>
