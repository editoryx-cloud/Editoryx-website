<style>
  :root {
    --bg: #0A0A0A;
    --band: #111111;
    --card: #1A1A1A;
    --text: #F0F0F0;
    --muted: #858585;
    --line: #222222;
    --line-strong: #353535;
    --accent: #ECFE6A;
    --accent-ink: #0A0A0A;
    --display: "Syne", "Arial Black", Arial, sans-serif;
    --body: "DM Sans", "Helvetica Neue", Arial, sans-serif;
    --header-h: 72px;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { color-scheme: dark; scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--body);
    font-size: 1rem;
    line-height: 1.6;
  }
  h1, h2, h3, p, ol, ul, fieldset, legend { margin: 0; padding: 0; }
  ol, ul { list-style: none; }
  fieldset { border: 0; min-width: 0; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  section[id] { scroll-margin-top: var(--header-h); }

  .wrap { max-width: 1160px; margin: 0 auto; padding: 0 clamp(24px, 5vw, 48px); }
  .accent { color: var(--accent); }

  /* Buttons */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.6em;
    padding: 16px 26px;
    border: 1px solid transparent; border-radius: 2px;
    font-family: var(--display); font-weight: 700; font-size: 0.8rem; line-height: 1.2;
    letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; white-space: nowrap;
    cursor: pointer; transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .btn-accent { background: var(--accent); color: var(--accent-ink); }
  .btn-accent:hover { background: #F6FFB0; }
  .btn-ghost { border-color: var(--line-strong); color: var(--text); background: transparent; }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

  /* Header */
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(10, 10, 10, 0.88);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: var(--header-h); }
  .logo {
    font-family: var(--display); font-weight: 800; font-size: 1.45rem; line-height: 1;
    letter-spacing: -0.02em; text-decoration: none; color: var(--text);
  }
  .site-nav { display: flex; align-items: center; gap: 10px; }
  .site-nav .btn { padding: 13px 18px; font-size: 0.72rem; }

  /* Hero */
  .hero { position: relative; overflow: hidden; padding: clamp(40px, 7vw, 88px) 0 clamp(56px, 8vw, 96px); }
  .hero .wrap { position: relative; z-index: 1; }
  .hero-ghost {
    position: absolute; z-index: 0; right: 3%; top: 46%;
    font-family: var(--display); font-weight: 800; font-size: clamp(5.5rem, 24vw, 19rem); line-height: 0.8;
    letter-spacing: -0.02em; color: transparent; -webkit-text-stroke: 1px #181818;
    pointer-events: none; user-select: none;
  }
  .tag {
    display: inline-flex; align-items: center; gap: 12px;
    padding: 7px 18px;
    background: #141414; border: 1px solid var(--line); border-radius: 999px;
    font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted);
  }
  .tag::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .hero h1 {
    margin-top: clamp(24px, 4vw, 36px);
    font-family: var(--display); font-weight: 800;
    font-size: clamp(2.5rem, 11.6vw, 6.75rem); line-height: 1.02; letter-spacing: -0.02em;
  }
  .hero h1 span { display: block; }
  .hero-lede {
    max-width: 30em; margin-top: clamp(22px, 3vw, 32px);
    color: var(--muted); font-weight: 300; font-size: clamp(1.0625rem, 1.6vw, 1.25rem); line-height: 1.65;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: clamp(28px, 4vw, 40px); }
  .stats {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 24px;
    margin-top: clamp(52px, 8vw, 80px); padding-top: clamp(40px, 6vw, 56px);
    border-top: 1px solid var(--line);
  }
  .stat-num { font-family: var(--display); font-weight: 800; font-size: clamp(2.1rem, 6vw, 3rem); line-height: 1; letter-spacing: -0.02em; color: var(--accent); }
  .stat-label { margin-top: 12px; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }

  /* Ticker */
  .ticker { overflow: hidden; background: var(--band); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 17px 0; }
  .ticker-track { display: flex; width: max-content; animation: ticker 36s linear infinite; }
  .ticker-group { display: flex; flex: none; }
  .ticker-group span {
    display: flex; align-items: center; padding-left: 28px;
    font-family: var(--display); font-weight: 700; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--muted); white-space: nowrap;
  }
  .ticker-group span::after { content: ""; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); margin-left: 28px; }
  @keyframes ticker { to { transform: translateX(-50%); } }

  /* Sections */
  .section { padding: clamp(72px, 10vw, 128px) 0; }
  .band { background: var(--band); }
  .eyebrow {
    display: flex; align-items: center; gap: 14px;
    font-size: 0.72rem; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent);
  }
  .eyebrow::before { content: ""; flex: none; width: 24px; height: 1px; background: var(--accent); }
  .section h2 {
    margin-top: 18px;
    font-family: var(--display); font-weight: 800;
    font-size: clamp(1.9rem, 5.4vw, 3.5rem); line-height: 1.04; letter-spacing: -0.02em;
  }
  .lede { max-width: 36em; margin-top: 18px; color: var(--muted); font-weight: 300; font-size: 1.0625rem; line-height: 1.7; }

  /* Process */
  .steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; margin-top: clamp(40px, 6vw, 64px); }
  .step { background: var(--band); border-top: 2px solid var(--line); padding: clamp(24px, 3vw, 36px) clamp(18px, 2.6vw, 32px) clamp(30px, 4vw, 44px); }
  .step { position: relative; }
  .step::before {
    content: ""; position: absolute; left: 0; top: -2px; width: 100%; height: 2px;
    background: var(--accent); transform: scaleX(0); transform-origin: left;
    transition: transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .step:first-child::before, .step:hover::before { transform: scaleX(1); }
  .step-num { transition: color 0.3s; }
  .step:hover .step-num { color: #4A4A4A; }
  .step-num { font-family: var(--display); font-weight: 800; font-size: clamp(2.3rem, 6vw, 3.25rem); line-height: 1; letter-spacing: -0.02em; color: #2B2B2B; }
  .step h3 { margin-top: 22px; font-family: var(--display); font-weight: 700; font-size: clamp(1rem, 1.7vw, 1.15rem); line-height: 1.25; }
  .step p { margin-top: 12px; color: var(--muted); font-weight: 300; font-size: 0.95rem; line-height: 1.65; }

  /* Shared bits */
  .pill {
    display: inline-block; padding: 7px 14px;
    background: var(--accent); color: var(--accent-ink); border-radius: 999px;
    font-family: var(--display); font-weight: 700; font-size: 0.66rem; line-height: 1; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap;
  }
  .checks { display: flex; flex-wrap: wrap; gap: 8px 24px; color: var(--muted); font-weight: 300; }
  .checks li::before { content: "✓"; margin-right: 0.45em; }

  /* Trial */
  .trial { margin-top: clamp(40px, 6vw, 56px); background: #141414; border: 1px solid var(--accent); border-radius: 2px; padding: clamp(26px, 4vw, 40px); }
  .trial-note { margin-top: 16px; color: var(--muted); font-weight: 300; }
  .trial-price { margin-top: 10px; font-family: var(--display); font-weight: 800; font-size: clamp(2.6rem, 9vw, 3.75rem); line-height: 1; letter-spacing: -0.02em; }
  .trial-price small { font-family: var(--body); font-weight: 400; font-size: 1rem; letter-spacing: -0.02em; color: var(--muted); margin-left: 4px; }
  .trial-desc { margin-top: 10px; color: var(--muted); font-weight: 300; }
  .trial .btn { margin-top: 22px; }
  .trial .checks { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line); }

  /* Plan builder */
  .builder { display: grid; grid-template-columns: minmax(0, 1fr); gap: 44px; margin-top: clamp(44px, 6vw, 64px); }
  .group + .group { margin-top: 36px; }
  .group legend { margin-bottom: 16px; }
  .group-label {
    display: flex; align-items: center; gap: 14px;
    font-family: var(--display); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);
  }
  .group-label::before { content: ""; flex: none; width: 24px; height: 1px; background: var(--accent); }
  .group-label small { font-family: var(--body); font-weight: 400; font-size: 0.72rem; letter-spacing: 0.16em; color: var(--muted); }

  .choices { display: grid; gap: 6px; }
  .choices.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .choice {
    position: relative; display: block; text-align: center;
    padding: 22px 14px;
    background: var(--card); border: 1px solid var(--line); border-radius: 2px;
    cursor: pointer; transition: border-color 0.15s;
  }
  .choice input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .choice:hover { border-color: var(--line-strong); }
  .choice.is-on { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .choice:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  .choice-name { display: block; font-family: var(--display); font-weight: 800; font-size: 1.15rem; line-height: 1.15; letter-spacing: -0.01em; }
  .choice-note { display: block; margin-top: 8px; color: var(--muted); font-weight: 300; font-size: 0.95rem; line-height: 1.35; }
  .choice-rate { display: block; margin-top: 6px; color: var(--accent); font-size: 0.95rem; white-space: nowrap; }

  .stepper { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .stepper button {
    width: 54px; height: 54px; flex: none;
    background: var(--card); border: 1px solid var(--line); border-radius: 2px;
    font-family: var(--body); font-size: 1.5rem; line-height: 1; color: var(--text); cursor: pointer;
  }
  .stepper button:hover { border-color: var(--accent); color: var(--accent); }
  .stepper input {
    width: 6.5rem; height: 54px; text-align: center;
    background: var(--card); border: 1px solid var(--line-strong); border-radius: 2px;
    font-family: var(--display); font-weight: 800; font-size: 1.4rem; color: var(--text);
    -moz-appearance: textfield; appearance: textfield;
  }
  .stepper input:focus { outline: none; border-color: var(--accent); }
  .stepper input::-webkit-outer-spin-button, .stepper input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .stepper-unit { margin-left: 10px; color: var(--muted); font-weight: 300; }

  .quote-card {
    position: relative; container-type: inline-size;
    background: var(--card); border: 1px solid var(--accent); border-radius: 2px;
    padding: 46px clamp(20px, 4vw, 28px) 28px; text-align: center;
  }
  .quote-card .pill { position: absolute; top: 0; left: 50%; transform: translate(-50%, -50%); }
  .quote-price {
    font-family: var(--display); font-weight: 800; line-height: 1; letter-spacing: -0.02em; white-space: nowrap;
    font-size: 3rem;
    font-size: min(3.5rem, calc(100cqi / var(--chars, 4) * 1.15));
  }
  .quote-count { margin-top: 14px; color: var(--muted); font-weight: 300; font-size: 1.1rem; }
  .quote-rate { margin-top: 4px; color: var(--accent); font-size: 1.1rem; }
  .quote-card .checks { justify-content: center; margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--line); }
  .quote-card .btn { width: 100%; margin-top: 24px; white-space: normal; }
  .quote-note { margin-top: 14px; color: var(--muted); font-weight: 300; font-size: 0.95rem; line-height: 1.5; }
  .quote-note strong { color: var(--text); font-weight: 700; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Contact */
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 52px; }
  .contact-points { display: grid; gap: 14px; margin-top: clamp(36px, 5vw, 52px); }
  .contact-points li { display: flex; align-items: center; gap: 16px; color: var(--muted); font-weight: 300; }
  .contact-points a { color: var(--muted); text-decoration: none; }
  .contact-points a:hover { color: var(--text); }
  .contact-points a.link { color: var(--accent); font-weight: 400; text-decoration: underline; text-underline-offset: 3px; }
  .icon-box { flex: none; display: grid; place-items: center; width: 40px; height: 40px; background: #141414; border: 1px solid var(--line); border-radius: 2px; font-size: 1rem; }

  .onboard { display: grid; gap: 22px; background: var(--band); border: 1px solid var(--line); border-radius: 2px; padding: clamp(26px, 4vw, 44px); }
  .onboard h3 { font-family: var(--display); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .row { display: grid; gap: 14px; }
  .row.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .field label, .field-label { display: block; margin-bottom: 9px; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .field input, .field textarea, .plan-box {
    width: 100%; padding: 14px 16px;
    background: var(--card); border: 1px solid var(--line); border-radius: 2px;
    font-family: var(--body); font-size: 1rem; font-weight: 400; line-height: 1.4; color: var(--text);
  }
  .field textarea { min-height: 96px; resize: vertical; }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--accent); }
  .field ::placeholder { color: #6C6C6C; opacity: 1; }
  .plan-box { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 16px; }
  .plan-box .plan-quote { color: var(--accent); white-space: nowrap; }
  .plan-change { display: inline-block; margin-top: 8px; color: var(--muted); font-size: 0.9rem; }
  .plan-change:hover { color: var(--accent); }
  .onboard .btn { width: 100%; padding: 20px 20px; font-size: 0.9rem; white-space: normal; }
  .form-status { font-weight: 400; min-height: 1.5em; color: var(--text); }
  .form-status.error { color: #FF8A7A; }
  .form-status a { color: var(--accent); }

  /* Footer */
  .site-footer { border-top: 1px solid var(--line); padding: 36px 0; }
  .footer-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 32px; }
  .footer-nav { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .footer-nav a { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); text-decoration: none; }
  .footer-nav a:hover { color: var(--accent); }
  .copyright { color: var(--muted); font-size: 0.85rem; font-weight: 300; }

  @media (max-width: 440px) {
    .site-header .logo { font-size: 1.2rem; }
    .header-inner { gap: 8px; }
    .site-nav { gap: 6px; }
    .site-nav .btn { padding: 12px 9px; font-size: 0.6rem; letter-spacing: 0.06em; }
    .hero-actions { gap: 10px; }
    .hero-actions .btn { flex: 1 1 auto; padding: 16px 10px; font-size: 0.74rem; letter-spacing: 0.08em; }
    .choices.two .choice-name { font-size: 1rem; }
  }
  @media (max-width: 374px) {
    .site-nav .btn-ghost { display: none; }
  }
  @media (max-width: 619px) {
    .choices.three .choice { display: grid; grid-template-columns: 1fr auto; align-items: center; column-gap: 14px; text-align: left; padding: 16px 18px; }
    .choices.three .choice-name { grid-column: 1; font-size: 1.05rem; }
    .choices.three .choice-note { grid-column: 1; margin-top: 4px; }
    .choices.three .choice-rate { grid-column: 2; grid-row: 1 / span 2; margin: 0; }
  }
  @media (min-width: 620px) {
    .choices.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .trial { display: grid; grid-template-columns: 1fr auto; column-gap: 40px; align-items: center; }
    .trial .btn { margin-top: 0; grid-column: 2; grid-row: 1; }
    .trial .checks { grid-column: 1 / -1; }
  }
  @media (min-width: 760px) {
    .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (min-width: 940px) {
    .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .builder { grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr); gap: 56px; align-items: start; }
    .quote-card { position: sticky; top: calc(var(--header-h) + 40px); margin-top: 34px; }
    .contact-grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 72px; align-items: start; }
  }

  /* ---------- Motion ---------- */
  /* Buttons: lift on hover, arrow nudges forward */
  .btn { transition: background-color 0.15s, border-color 0.15s, color 0.15s, transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .btn:hover { transform: translateY(-2px); }
  .btn:active { transform: translateY(0) scale(0.98); }
  .btn span[aria-hidden] { display: inline-block; transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .btn:hover span[aria-hidden] { transform: translateX(5px); }
  .choice { transition: border-color 0.15s, transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .choice:hover { transform: translateY(-2px); }
  .ticker:hover .ticker-track { animation-play-state: paused; }

  /* Hero: plays once when the page opens */
  .hero h1 .line { overflow: hidden; padding: 0.08em 0.04em; margin: -0.08em -0.04em; }
  .hero h1 .line > span { animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s both; }
  .hero h1 .line + .line > span { animation-delay: 0.3s; }
  .tag { animation: fade-up 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.05s both; }
  .tag::before { animation: pulse 2.4s ease-out 1s infinite; }
  .hero-lede { animation: fade-up 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.55s both; }
  .hero-actions { animation: fade-up 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.68s both; }
  .stats { animation: fade-up 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.82s both; }
  .hero-ghost { animation: ghost-in 1.6s ease-out 0.4s both; will-change: transform; }
  .site-header { animation: drop-in 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes rise { from { transform: translateY(110%); } to { transform: none; } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes ghost-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes drop-in { from { opacity: 0; transform: translateY(-100%); } to { opacity: 1; transform: none; } }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(236, 254, 106, 0.55); }
    70%, 100% { box-shadow: 0 0 0 8px rgba(236, 254, 106, 0); }
  }

  /* Scroll reveals: only switched on by the script, so nothing hides without it */
  .motion [data-reveal] {
    opacity: 0; transform: translateY(26px);
    transition: opacity 0.75s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms), transform 0.75s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms);
  }
  .motion [data-reveal].in { opacity: 1; transform: none; }
  .motion .eyebrow[data-reveal]::before { transform: scaleX(0); transform-origin: left; transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--d, 0ms) + 250ms); }
  .motion .eyebrow[data-reveal].in::before { transform: scaleX(1); }
